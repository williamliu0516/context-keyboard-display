# Host-specific inputs for docker-compose.yml. `deploy/ckd-docker.sh env`
# writes the real .env by asking this machine, and .env is not tracked --
# nothing here is secret, but a uid and a timezone are facts about one Mac.
#
# The panel's address is deliberately NOT here: it stays in
# ~/.claude/context-keyboard-display.yaml, which the container reads live
# through the mount.

# Your host user, so files written through the ~/.claude mount keep the
# ownership the native daemon and the hotkey listener expect. `id -u`, `id -g`.
CKD_UID=502
CKD_GID=20

# The Idle screen is a clock; an unset TZ shows UTC on the panel.
TZ=America/Los_Angeles

# The claude-code-keyboard-status checkout, copied into the image at build
# time as the renderer library. Relative paths resolve against this repo.
CKD_UPSTREAM_PATH=../claude-code-keyboard-status

# Mounted read-only at the same absolute path, so `git diff --shortstat` can
# answer for the repos your sessions record as their cwd.
CKD_PROJECTS_DIR=/Users/you/projects

# Build knobs. INSTALL_CJK_FONT=0 drops ~215 MB and renders CJK as tofu.
CKD_PYTHON_TAG=3.13-slim-bookworm
CKD_INSTALL_CJK_FONT=1
